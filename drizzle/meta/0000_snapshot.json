        "transactions_amount_ck": {
          "name": "transactions_amount_ck",
          "value": "(\"transactions\".\"type\" = 'adjustment' and \"transactions\".\"amount_paise\" <> 0) or \"transactions\".\"amount_paise\" > 0"
        },
        "transactions_transfer_ck": {
          "name": "transactions_transfer_ck",
          "value": "(\"transactions\".\"type\" = 'transfer') = (\"transactions\".\"to_account_id\" is not null)\n          and (\"transactions\".\"to_account_id\" is null or \"transactions\".\"to_account_id\" <> \"transactions\".\"account_id\")"
        },
        "transactions_category_ck": {
          "name": "transactions_category_ck",
          "value": "\"transactions\".\"type\" not in ('expense', 'income') or \"transactions\".\"category_id\" is not null"
        }
