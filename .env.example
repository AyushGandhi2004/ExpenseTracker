# Copy to .env.local and fill in values from your Supabase project (region: Mumbai / ap-south-1).

# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# "Publishable key" (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings → Database → Connection string
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Session pooler / direct (port 5432) — used by drizzle-kit for migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Only this Google account may sign in
ALLOWED_EMAIL=you@gmail.com
